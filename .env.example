# Copy to .env for local development. Never commit real values.
# Postgres connection string. Leave unset to use SQLite (./data/wine.db) locally.
DATABASE_URL=
# Railway provides PORT automatically; locally defaults to 8000.
PORT=
# Public origin used in QR codes and share links, e.g. https://your-app.up.railway.app
PUBLIC_BASE_URL=
# none | elevenlabs | openai
TTS_PROVIDER=none
TTS_API_KEY=
TTS_VOICE_ID=
